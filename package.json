{
  "name": "@argszero/cordis-plugin-session-event-guard",
  "description": "Diagnoses, at the write boundary, the one session-log mistake an external plugin cannot see: Session.append builds and freezes the envelope itself and cannot set `ignorable`, so any event type outside this harness's generated vocabulary written that way is a REQUIRED event, and the storage read path refuses the whole log later \u2014 in a different process, for every reader that does not load the writing plugin. The plugin judges a type before it is written on both write paths, audits stored sessions through the same validated read seam a restart uses and quotes the reader's refusal verbatim, observes live session/event writes so the mistake is reported where it is made, and builds the envelope the public handle seam accepts. It never writes to a session log.",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argszero/cordis-plugin-session-event-guard.git"
  },
  "homepage": "https://github.com/argszero/cordis-plugin-session-event-guard#readme",
  "bugs": {
    "url": "https://github.com/argszero/cordis-plugin-session-event-guard/issues"
  },
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "plugin",
    "session",
    "session-log",
    "session-event",
    "ignorable",
    "persistence",
    "diagnostics",
    "tool"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session": ">=0.1.7-alpha.1 <0.2.0 || >=0.2.0-rc.1 <0.2.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.7-alpha.1 <0.2.0 || >=0.2.0-rc.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-alpha.1 <0.2.0 || >=0.2.0-rc.1 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@types/node": "^24.19.0",
    "semver": "^7.6.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "tsc",
    "test": "node --test \"test/*.spec.mjs\"",
    "test:probe-lines": "node scripts/probe-lines.mjs",
    "test:inject": "node scripts/inject-defects.mjs",
    "prepublishOnly": "tsc"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
